APP_NAME=ProofPatcher
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Set once by the operator to enable GitHub device sign-in.
PROOFPATCH_GITHUB_CLIENT_ID=

# Local model request count; the separate $0.50 estimated reservation limit remains in force.
PROOFPATCH_MODEL_MAX_ATTEMPTS=10

# Optional exact allowlist for the dedicated test workflow; leave empty to disable it.
PROOFPATCH_TEST_REPO=
PROOFPATCH_TEST_BASE_COMMIT=
