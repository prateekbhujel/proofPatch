#!/usr/bin/env php
<?php

declare(strict_types=1);

use ProofPatch\GitHub\PullRequestSnapshot;

require dirname(__DIR__).'/vendor/autoload.php';

try {
    if ($argc < 2 || $argc > 3) {
        throw new InvalidArgumentException('Usage: php bin/check-pull-snapshot SNAPSHOT_ID [EXPECTED_SHA256]');
    }
    $result = (new PullRequestSnapshot(dirname(__DIR__).'/artifacts/pull-requests'))->verify($argv[1], $argv[2] ?? null);
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT)."\n";
} catch (Throwable $error) {
    fwrite(STDERR, 'Snapshot check failed: '.$error->getMessage()."\n");
    exit(1);
}
