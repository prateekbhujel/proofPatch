{
    "name": "prateekbhujel/proofpatcher",
    "description": "Falsifiable AI verification engine and GitHub co-maintainer workbench.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-json": "*",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.0",
        "symfony/http-client": "^7.4",
        "symfony/panther": "^2.3",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "dbrekelmans/bdi": "^1.4"
    },
    "autoload": {"psr-4": {"ProofPatch\\": "app/", "App\\": "app/"}},
    "autoload-dev": {"psr-4": {"ProofPatch\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit",
        "drivers": "bdi detect drivers"
    },
    "config": {"sort-packages": true, "allow-plugins": {}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
