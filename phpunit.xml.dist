<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true">
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="MODAL_GRANT_VERIFIED" value="false"/>
    </php>
    <testsuites>
        <testsuite name="ProofPatch"><directory>tests/Unit</directory><directory>tests/Integration</directory></testsuite>
    </testsuites>
</phpunit>
